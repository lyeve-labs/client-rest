{
  "name": "@lyeve-labs/client-rest",
  "version": "0.2.3",
  "description": "REST API client for the LyEve Core - typed fetch functions for all admin and content endpoints",
  "license": "MIT",
  "author": "LyEve <info@lyeve.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyeve-labs/client-rest.git"
  },
  "homepage": "https://github.com/lyeve-labs/client-rest#readme",
  "bugs": {
    "url": "https://github.com/lyeve-labs/client-rest/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm version:check && tsup && publint && node scripts/check-dist.mjs",
    "version:check": "node scripts/check-version.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@lyeve-labs/client": ">=0.2.1"
  },
  "devDependencies": {
    "@lyeve-labs/client": "^0.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "publint": "^0.3.0",
    "prettier": "^3.4.0"
  }
}
